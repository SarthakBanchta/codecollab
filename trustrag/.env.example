# ── TrustRAG Environment Configuration ───────────────────────────────────────
# Copy this file to .env and fill in your API key(s).

# LLM Provider: "openai" or "anthropic"
LLM_PROVIDER=openai

# API Keys (set the one matching your provider)
OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model names (defaults are cheap/fast)
# GENERATION_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# Retrieval settings
# TOP_K=4
# SIMILARITY_THRESHOLD=0.5

# Chunking settings
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100

# Storage paths (defaults are relative to trustrag/)
# CHROMA_PERSIST_DIR=./chroma_db
# SQLITE_DB_PATH=./trustrag_logs.db
# DATA_DIR=./data

# Validation thresholds
# SCORE_SHOW_THRESHOLD=80
# SCORE_WARN_THRESHOLD=50
